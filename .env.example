# Copy to .env.local and fill in. Never commit .env.local.

# Direct Postgres connection (used by `npm run db:migrate`)
DATABASE_URL=""

# Pooled connection used by the app (Supabase: Connection pooling → Transaction mode, port 6543)
DATABASE_URL_POOLED=""

# Signs admin login cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Optional: public URL of the site, used in calendar links
NEXT_PUBLIC_SITE_URL=""
